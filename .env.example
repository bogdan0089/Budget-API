DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_budget
# Host port for the Postgres container (docker compose only)
DB_EXTERNAL_PORT=5433

SECRET_KEY=your-secret-key-change-this-to-something-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Password reset emails (leave SMTP_HOST empty in dev — link is logged to console)
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Smart Budget <no-reply@smartbudget.app>
